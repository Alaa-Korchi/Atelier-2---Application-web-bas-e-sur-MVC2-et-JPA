<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="ecommercePU"
                      transaction-type="RESOURCE_LOCAL">

        <!-- Fournisseur JPA : EclipseLink -->
        <provider>
            org.eclipse.persistence.jpa.PersistenceProvider
        </provider>

        <!-- Entités JPA -->
        <class>ma.fstt.model.Client</class>
        <class>ma.fstt.model.Produit</class>
        <class>ma.fstt.model.Commande</class>
        <class>ma.fstt.model.LigneCommande</class>

        <properties>

            <!-- Connexion MySQL -->
            <property name="jakarta.persistence.jdbc.driver"
                      value="com.mysql.cj.jdbc.Driver"/>

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/ecommerce_jpa?serverTimezone=UTC"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="root"/>

            <property name="jakarta.persistence.jdbc.password"
                      value="alae2006.2021"/>

            <!-- Génération automatique des tables -->
            <property name="eclipselink.ddl-generation"
                      value="none"/>

            <!-- Affichage des requêtes SQL -->
            <property name="eclipselink.logging.level"
                      value="FINE"/>

        </properties>

    </persistence-unit>

</persistence>
